# Supabase → Project settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Never expose this in client code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Recommended: any long random string, e.g. the output of `openssl rand -hex 32`.
# Used for the cookie-free visitor count and spam-check hashes.
HASH_SALT=

# Optional: contact email shown on the privacy page (Instagram @minflix is always shown).
PRIVACY_EMAIL=

# No site URL needed: links use the domain the site is opened on.
